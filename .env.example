# ──────────────────────────────────────────────────────────────────────
# YouTube Trending Data Pipeline — environment template
# Copy this file to `.env` and fill in REAL values. `.env` is gitignored.
# Never commit real keys, account IDs, or ARNs.
# ──────────────────────────────────────────────────────────────────────

# ── Google / YouTube ──────────────────────────────────────────────────
YOUTUBE_API_KEY=AIzaSy_your_key_here

# ── AWS core ──────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=000000000000
ENV=dev

# ── Regions to ingest (ISO 3166-1 alpha-2, UPPERCASE for the API) ─────
YOUTUBE_REGIONS=US,GB,CA,DE,FR,IN,JP,KR,MX,RU

# ── S3 buckets (filled in Stage 1) ────────────────────────────────────
S3_BUCKET_BRONZE=yt-data-pipeline-bronze-ap-south-1-dev
S3_BUCKET_SILVER=yt-data-pipeline-silver-ap-south-1-dev
S3_BUCKET_GOLD=yt-data-pipeline-gold-ap-south-1-dev
S3_BUCKET_SCRIPT=yt-data-pipeline-script-ap-south-1-dev

# ── Glue databases ────────────────────────────────────────────────────
GLUE_DB_BRONZE=yt_pipeline_bronze_dev
GLUE_DB_SILVER=yt_pipeline_silver_dev
GLUE_DB_GOLD=yt_pipeline_gold_dev

# ── SNS (filled in Stage 1) ───────────────────────────────────────────
SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:yt-data-pipeline-alerts-dev

# ── Alert email ───────────────────────────────────────────────────────
ALERT_EMAIL=you@example.com

# ── Data Quality thresholds ───────────────────────────────────────────
DQ_MIN_ROW_COUNT=10
DQ_MAX_NULL_PERCENT=5.0
