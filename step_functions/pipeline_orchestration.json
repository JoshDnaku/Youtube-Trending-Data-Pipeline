{
  "Comment": "YouTube Trending Data Pipeline - full orchestration. Ingest -> parallel Silver transforms -> DQ gate -> (pass) Gold / (fail) alert.",
  "StartAt": "IngestFromYouTubeAPI",
  "States": {
    "IngestFromYouTubeAPI": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-south-1:<ACCOUNT_ID>:function:yt-data-pipeline-youtube-ingestion-dev",
        "Payload": { "triggered_by": "step_functions", "execution_id.$": "$$.Execution.Id" }
      },
      "ResultPath": "$.ingestion_result",
      "Retry": [
        { "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "States.TaskFailed"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2 }
      ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "Next": "NotifyIngestionFailure", "ResultPath": "$.error" } ],
      "Next": "WaitForS3Consistency"
    },

    "WaitForS3Consistency": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "SilverTransforms"
    },

    "SilverTransforms": {
      "Type": "Parallel",
      "Comment": "Run live statistics transform and category reference transform in parallel (both free Lambdas).",
      "Branches": [
        {
          "StartAt": "LiveToSilver",
          "States": {
            "LiveToSilver": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "arn:aws:lambda:ap-south-1:<ACCOUNT_ID>:function:yt-data-pipeline-live-to-silver-dev",
                "Payload": { "triggered_by": "step_functions" }
              },
              "Retry": [ { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2 } ],
              "End": true
            }
          }
        },
        {
          "StartAt": "TransformReferenceData",
          "States": {
            "TransformReferenceData": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "arn:aws:lambda:ap-south-1:<ACCOUNT_ID>:function:yt-data-pipeline-json-to-parquet-dev",
                "Payload": { "triggered_by": "step_functions" }
              },
              "Retry": [ { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2 } ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.silver_results",
      "Catch": [ { "ErrorEquals": ["States.ALL"], "Next": "NotifyTransformFailure", "ResultPath": "$.error" } ],
      "Next": "RunDataQualityChecks"
    },

    "RunDataQualityChecks": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-south-1:<ACCOUNT_ID>:function:yt-data-pipeline-data-quality-dev",
        "Payload": {
          "database": "yt_pipeline_silver_dev",
          "tables": ["clean_statistics", "clean_reference_data"]
        }
      },
      "ResultPath": "$.dq_result",
      "Retry": [ { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2 } ],
      "Next": "EvaluateDataQuality"
    },

    "EvaluateDataQuality": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.dq_result.Payload.quality_passed", "BooleanEquals": true, "Next": "RunSilverToGoldGlueJob" }
      ],
      "Default": "NotifyDQFailure"
    },

    "RunSilverToGoldGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "yt-data-pipeline-silver-to-gold-dev",
        "Arguments": {
          "--silver_database": "yt_pipeline_silver_dev",
          "--gold_bucket": "yt-data-pipeline-gold-ap-south-1-dev-484990",
          "--gold_database": "yt_pipeline_gold_dev"
        }
      },
      "ResultPath": "$.glue_gold_result",
      "Retry": [ { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 60, "MaxAttempts": 1, "BackoffRate": 2 } ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "Next": "NotifyGoldFailure", "ResultPath": "$.error" } ],
      "Next": "NotifySuccess"
    },

    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:yt-data-pipeline-alerts-dev",
        "Subject": "[YT Pipeline] Pipeline completed successfully",
        "Message.$": "States.Format('Pipeline run {} completed. All layers updated.', $$.Execution.Id)"
      },
      "End": true
    },

    "NotifyIngestionFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:yt-data-pipeline-alerts-dev",
        "Subject": "[YT Pipeline] FAILURE - Ingestion step failed",
        "Message.$": "States.JsonToString($.error)"
      },
      "End": true
    },

    "NotifyTransformFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:yt-data-pipeline-alerts-dev",
        "Subject": "[YT Pipeline] FAILURE - Silver transform failed",
        "Message.$": "States.JsonToString($.error)"
      },
      "End": true
    },

    "NotifyDQFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:yt-data-pipeline-alerts-dev",
        "Subject": "[YT Pipeline] WARNING - Data quality checks failed, Gold skipped",
        "Message.$": "States.JsonToString($.dq_result.Payload)"
      },
      "End": true
    },

    "NotifyGoldFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:yt-data-pipeline-alerts-dev",
        "Subject": "[YT Pipeline] FAILURE - Gold aggregation failed",
        "Message.$": "States.JsonToString($.error)"
      },
      "End": true
    }
  }
}
