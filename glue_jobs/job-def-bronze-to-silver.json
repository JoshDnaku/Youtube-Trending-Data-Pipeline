{
  "Name": "yt-data-pipeline-bronze-to-silver-dev",
  "Role": "arn:aws:iam::<ACCOUNT_ID>:role/yt-data-pipeline-glue-role-dev",
  "GlueVersion": "4.0",
  "WorkerType": "G.1X",
  "NumberOfWorkers": 2,
  "MaxRetries": 0,
  "Timeout": 30,
  "ExecutionProperty": { "MaxConcurrentRuns": 1 },
  "Command": {
    "Name": "glueetl",
    "PythonVersion": "3",
    "ScriptLocation": "s3://yt-data-pipeline-script-ap-south-1-dev-484990/glue_jobs/bronze_to_silver_statistics.py"
  },
  "DefaultArguments": {
    "--job-language": "python",
    "--enable-metrics": "true",
    "--enable-continuous-cloudwatch-log": "true",
    "--job-bookmark-option": "job-bookmark-disable",
    "--bronze_bucket": "yt-data-pipeline-bronze-ap-south-1-dev-484990",
    "--silver_bucket": "yt-data-pipeline-silver-ap-south-1-dev-484990",
    "--silver_database": "yt_pipeline_silver_dev",
    "--silver_table": "clean_statistics",
    "--regions": "all"
  }
}
